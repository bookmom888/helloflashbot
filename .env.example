# 代理管理系统环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 数据库配置
PROXY_DB_PATH=data/proxies.db
PROXY_JSON_BACKUP_PATH=data/proxies.json

# API代理服务配置
API_PROXIES_ENABLED=false
EXAMPLE_PROVIDER_API_KEY=your_api_key_here
ANOTHER_PROVIDER_API_KEY=your_another_api_key_here

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/proxy_manager.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# 监控配置
MONITORING_ENABLED=true
METRICS_COLLECT_INTERVAL=60
ALERT_SUCCESS_RATE_MIN=80
ALERT_RESPONSE_TIME_MAX=10
ALERT_ERROR_RATE_MAX=20

# 验证配置
VALIDATION_TIMEOUT=10
VALIDATION_MAX_RETRIES=3
VALIDATION_MAX_THREADS=10

# 异步验证配置
ASYNC_VALIDATION_ENABLED=true
ASYNC_MAX_CONCURRENT=50
ASYNC_TIMEOUT=10

# 健康检查配置
HEALTH_CHECK_INTERVAL=300
HEALTH_CHECK_MAX_ERROR_COUNT=5
HEALTH_CHECK_ERROR_THRESHOLD_TIME=300

# 性能配置
CONNECTION_POOL_MAX_CONNECTIONS=100
CONNECTION_POOL_MAX_CONNECTIONS_PER_HOST=10
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# 安全配置
SSL_VERIFY_CERTIFICATES=false
SSL_USE_SYSTEM_CA=true
AUTH_TIMEOUT=30
AUTH_MAX_RETRIES=2

# 调试配置
DEBUG_ENABLED=false
DEBUG_VERBOSE_LOGGING=false
DEBUG_SAVE_FAILED_REQUESTS=false
DEBUG_FAILED_REQUESTS_PATH=debug/failed_requests.log